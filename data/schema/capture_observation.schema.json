{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptureObservation",
  "type": "object",
  "required": [
    "kind",
    "capture_metadata",
    "observed_facts",
    "provenance"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "donation",
        "aggregate"
      ]
    },
    "capture_metadata": {
      "type": "object",
      "required": [
        "capture_id",
        "source",
        "source_url",
        "captured_at",
        "collector_version",
        "capture_type",
        "source_reliability",
        "evidence_reference"
      ],
      "properties": {
        "capture_id": { "type": "string" },
        "source": { "type": "string" },
        "source_url": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" },
        "collector_version": { "type": "string" },
        "capture_type": { "type": "string" },
        "source_reliability": { "type": "string" },
        "evidence_reference": { "type": "string" },
        "artifact_sha256": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "observed_facts": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "required": [
        "evidence_reference",
        "extraction_method",
        "parser_confidence",
        "hash_verified"
      ],
      "properties": {
        "evidence_reference": { "type": "string" },
        "artifact_sha256": { "type": ["string", "null"] },
        "extraction_method": { "type": "string" },
        "parser_confidence": { "type": "string" },
        "hash_verified": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
