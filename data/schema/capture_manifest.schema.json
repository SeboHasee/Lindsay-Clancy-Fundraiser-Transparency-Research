{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptureManifest",
  "type": "object",
  "required": [
    "capture_id",
    "source",
    "source_url",
    "captured_at",
    "collector_version",
    "capture_type",
    "artifacts"
  ],
  "properties": {
    "capture_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "authorized_capture",
        "public_reporting",
        "archive"
      ]
    },
    "source_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "collector_version": {
      "type": "string",
      "minLength": 1
    },
    "capture_type": {
      "type": "string",
      "enum": [
        "html",
        "screenshot",
        "export",
        "archive",
        "mixed"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "media_type"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
